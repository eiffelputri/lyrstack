{
  "name": "magical-mirai-2026-lyric-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lyric puzzle game for the Magical Mirai 2026 programming contest, built with the TextAlive App API",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:deps": "npm audit --audit-level=moderate",
    "check": "npm run lint && npm run test && npm run audit:deps"
  },
  "dependencies": {
    "@fontsource/mochiy-pop-one": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "textalive-app-api": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
